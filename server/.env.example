# Puerto donde escucha la API (el frontend le pega acá)
PORT=3001

# Token que te da @BotFather al crear el bot en Telegram
TELEGRAM_BOT_TOKEN=

# Tu chat id de Telegram, para que solo vos puedas cargar gastos por el bot.
# Dejalo vacío la primera vez: al hacer /start el bot te va a decir cuál es.
TELEGRAM_ALLOWED_CHAT_ID=
